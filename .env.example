# ============================================================
# FLOW COLOMBIA — variables de entorno
# ------------------------------------------------------------
# Copia este archivo como .env (ya está en .gitignore) y rellena
# los valores reales. NUNCA subas .env al repositorio.
#
# Local (PowerShell):
#   $env:DATABASE_URL = "jdbc:postgresql://..."
#   .\mvnw.cmd spring-boot:run
#
# Producción: define estas variables en el panel del hosting.
# ============================================================

# --- Base de datos (Neon) -----------------------------------
# Usa la cadena POOLED del dashboard de Neon (-pooler) e incluye
# sslmode=require.
DATABASE_URL=jdbc:postgresql://<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=<usuario>
DATABASE_PASSWORD=<contraseña_rotada_en_neon>

# --- Acceso al panel (OBLIGATORIO) --------------------------
# Sin esta variable la aplicación NO arranca (fail-fast a propósito).
# Usa una contraseña larga y única; no reutilices ninguna anterior.
ADMIN_PASSWORD=<contraseña_larga_y_unica>

# --- Cookies ------------------------------------------------
# Ponlo en true cuando la tienda sirva por HTTPS.
SESSION_COOKIE_SECURE=true

# --- Servicios externos -------------------------------------
SENDGRID_API_KEY=

# El asistente funciona en modo local (sin IA) si falta la clave.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=400
DEEPSEEK_TIMEOUT_SECONDS=25
